	file.0000000000000001.title: "Create: Empyrean Engines"
	quest.00F44E2A039FDE10.quest_desc: [
		"Your &6world tier&r rises on its own with your play time and milestones:"
		"&aHaven&r at the start, &eFrontier&r at 5 h, &6Ascent&r at 15 h once you've been to the Nether, &cSummit&r at 30 h once you've killed the Wither, &5Pinnacle&r at 60 h once you've been to the End."
		""
		"A higher tier means harder night raids (more waves, better armour on the raiders, Elites and then Invaders) and better gems. It also lets your gear reach higher levels. Sieges get a little harder within a tier too, the longer you play."
	]
	quest.00F44E2A039FDE10.title: "World Tiers"
	quest.017976F9830C816D.quest_desc: [
		"Your first power source. Put it in flowing water."
	]
	quest.017976F9830C816D.title: "Water Wheel"
	quest.01EB4F8E964E4A05.quest_desc: [
		"Pull items in and out of anything."
	]
	quest.01EB4F8E964E4A05.title: "Funnels"
	quest.0618566213779297.quest_desc: [
		"Big recipes, done by machines."
	]
	quest.0618566213779297.title: "Mechanical Crafters"
	quest.0635FFA2161C851C.quest_desc: [
		"A tier 1 foundry is built from plain bricks: floor, walls and corners, all the same kind."
	]
	quest.0635FFA2161C851C.title: "Foundry Bricks"
	quest.085E83B071D5B549.quest_desc: [
		"Pipes, pumps and tanks move liquids. Copper casing opens fluid machines."
	]
	quest.085E83B071D5B549.title: "Copper and Fluids"
	quest.0988524BF2C669CF.quest_desc: [
		"Put a plain book and some lapis in an enchanting table. Click a button to begin: the three buttons light up and chime in an order. Click them back in the same order."
		""
		"Three rounds, each one step longer. A wrong press costs 1 lapis and plays the round again. Books in chiseled bookshelves around the table play it slower."
		""
		"Finish the third round and the book becomes a &dResearch Focus&r for a random kind of gear."
	]
	quest.0988524BF2C669CF.title: "Echo"
	quest.14C07CE62313C72B.quest_desc: [
		"Load a repair kit with materials and use it on worn gear."
	]
	quest.14C07CE62313C72B.title: "Repairs"
	quest.161F773EEFAE0B9E.quest_desc: [
		"Get through your first night."
	]
	quest.161F773EEFAE0B9E.title: "A Roof and a Bed"
	quest.1C789AEAC04A0DB7.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.1C789AEAC04A0DB7.title: "Azure Electrum"
	quest.1C9F2F26F3CA7CA5.quest_desc: [
		"The Nether is 1:1. Every block there is a block here."
	]
	quest.1C9F2F26F3CA7CA5.title: "Through the Portal"
	quest.1D408503336B6F94.quest_desc: [
		"Set an exact RPM."
	]
	quest.1D408503336B6F94.title: "Rotation Speed Controller"
	quest.20BF147E65051B14.quest_desc: [
		"Break old gear back down into parts and materials."
	]
	quest.20BF147E65051B14.title: "Salvager"
	quest.2129501A6E232B1F.quest_desc: [
		"Rotation travels through shafts and cogs. Large cogs change speed."
	]
	quest.2129501A6E232B1F.title: "Shafts and Cogs"
	quest.2251A18945B19799.quest_desc: [
		"The shell for smarter machines."
	]
	quest.2251A18945B19799.title: "Brass Casing"
	quest.2528654F1E81EF97.quest_desc: [
		"Bulk storage that grows with size."
	]
	quest.2528654F1E81EF97.title: "Item Vault"
	quest.2A46606BC2A136C7.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r andesite alloy, shafts and cogs, water wheels, the millstone, press, mixer, fans, drills, saws and belts."
		""
		"&7Until then these recipes stay hidden in JEI and can't be crafted. You can still use and trade the items if someone else makes them."
	]
	quest.2A46606BC2A136C7.quest_subtitle: "Learn this age at the Research Bench"
	quest.2A46606BC2A136C7.title: "Andesite Age"
	quest.2F252DBFBEB84507.quest_desc: [
		"A rarer, windier village."
	]
	quest.2F252DBFBEB84507.title: "Highwind"
	quest.321BF1A1BBE4410F.quest_desc: [
		"Put the focus back in the table and open its research tree. Pick a level: it costs a few XP levels to start, then the table pulls its resource from a chest, barrel or vault up to 2 blocks away."
		""
		"A book holds one enchantment. Researching a different line replaces it, so bind more books for more enchantments."
		""
		"Feed it with a hopper or a Create belt and the bigger levels research themselves."
	]
	quest.321BF1A1BBE4410F.title: "First Research"
	quest.33B02D03094CCD4D.quest_desc: [
		"Build a farm that harvests and collects on its own."
	]
	quest.33B02D03094CCD4D.title: "First Automated Farm"
	quest.366EBEC9A45AC5A1.quest_desc: [
		"Killing the Wither is the milestone for &cSummit&r (with 30 hours of play)."
	]
	quest.366EBEC9A45AC5A1.quest_subtitle: "Kill the Wither"
	quest.366EBEC9A45AC5A1.title: "Summit"
	quest.38E272BEC301C853.quest_desc: [
		"Mixing recipes. Some need heat underneath the basin."
	]
	quest.38E272BEC301C853.title: "Mixer and Basin"
	quest.39445CA3841B2487.quest_desc: [
		"They fly too. Board it."
	]
	quest.39445CA3841B2487.title: "Pillager Airship"
	quest.3A1DD46ED306379D.quest_desc: [
		"A mod kit lets you swap parts on a tool without starting over."
	]
	quest.3A1DD46ED306379D.title: "Swapping Parts"
	quest.3A67502FB1B16E8F.quest_desc: [
		"Steer and throttle from the deck."
	]
	quest.3A67502FB1B16E8F.title: "At the Helm"
	quest.3D89B36A28B15DD4.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.3D89B36A28B15DD4.title: "Azure Silver"
	quest.402CDE629135F79A.quest_desc: [
		"Something came down here. Someone was flying."
		"Search the wreck. There may be a map."
	]
	quest.402CDE629135F79A.title: "A Wreck in the Hills"
	quest.422E48930EA981A8.quest_desc: [
		"Catch a blaze in an empty blaze burner. Superheated mixing needs it."
	]
	quest.422E48930EA981A8.title: "Capture a Blaze"
	quest.443C440118CD9977.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r Crafts & Additions: alternators, motors, the rolling mill and wires."
		""
		"&7Until then these recipes stay hidden in JEI and can't be crafted. You can still use and trade the items if someone else makes them."
	]
	quest.443C440118CD9977.quest_subtitle: "Learn this age at the Research Bench"
	quest.443C440118CD9977.title: "Electricity Age"
	quest.49CD7CDF44232AC1.quest_desc: [
		"Plot a course."
	]
	quest.49CD7CDF44232AC1.title: "Navigation Table"
	quest.52C6999E0CE31C24.quest_desc: [
		"A &eFoundry Tap&r on a drain pours into a casting table or basin below. Pour molten gold over an ingot, nugget, plate, gem or Silent Gear part to make a reusable &egold cast&r of it, or click sand onto it for a one-use sand cast."
		"Silent Gear parts from metals and gems above iron can only be cast here, not crafted by hand. Pour metal over finished gear to coat it."
	]
	quest.52C6999E0CE31C24.title: "Casting"
	quest.535CEE7D8640DD6C.quest_desc: [
		"Whoever flew that wreck knew something you don't. Research Flight to learn it."
		""
		"&eResearch unlocks:&r Create Aeronautics: envelopes, burners, propellers, levitite, the physics assembler and controls. Needs the Brass Age first."
	]
	quest.535CEE7D8640DD6C.quest_subtitle: "Learn Flight at the Research Bench"
	quest.535CEE7D8640DD6C.title: "Flight"
	quest.55B4E304EAA31AC8.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.55B4E304EAA31AC8.title: "Netherite"
	quest.5E037319BF07DCE6.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r item vaults, portable storage interfaces, packagers, frogports and stock tickers."
		""
		"&7Until then these recipes stay hidden in JEI and can't be crafted. You can still use and trade the items if someone else makes them."
	]
	quest.5E037319BF07DCE6.quest_subtitle: "Learn this age at the Research Bench"
	quest.5E037319BF07DCE6.title: "Logistics"
	quest.61A405F49C73E0AF.quest_desc: [
		"Punch a tree and make a crafting table."
	]
	quest.61A405F49C73E0AF.title: "Getting Started"
	quest.62E6E8240892B2DF.quest_desc: [
		"Climb a mountain and look up. Sky villages, wrecks and loot drift above &bY 250&r."
		"You can't pillar up there. You'll have to fly."
	]
	quest.62E6E8240892B2DF.title: "The Sky Is Off-Limits"
	quest.6970297A89A93F61.quest_desc: [
		"Rolls ingots into rods and wire."
	]
	quest.6970297A89A93F61.title: "Rolling Mill"
	quest.72AA908A48110531.quest_desc: [
		"Rail lines for heavy freight. Trains are part of the Brass Age."
	]
	quest.72AA908A48110531.title: "Trains"
	quest.7557F1786D6F0996.quest_desc: [
		"Copper and zinc, alloyed in the foundry (alloys only come from the foundry now). Brass opens the next age and the sky."
	]
	quest.7557F1786D6F0996.title: "Brass"
	quest.766D007B2DE59619.quest_desc: [
		"The backbone of every early machine. Andesite plus iron nuggets."
	]
	quest.766D007B2DE59619.title: "Andesite Alloy"
	quest.77B9096FC74E3799.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.77B9096FC74E3799.title: "Blaze Gold"
	quest.79D8FB17B60C3C5E.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.79D8FB17B60C3C5E.title: "Crimson Iron"
	quest.7B8E1EA53DCC1054.quest_desc: [
		"Load and unload moving contraptions and ships."
	]
	quest.7B8E1EA53DCC1054.title: "Ship Cargo"
	quest.7E102607245F2767.quest_desc: [
		"Stone tools and a furnace. Your tools are made of parts. You'll learn what that means soon."
	]
	quest.7E102607245F2767.title: "Stone Age"
	quest.814A0EAEBA710452.quest_desc: [
		"Electricity only comes from rotation. An alternator turns RPM into power."
	]
	quest.814A0EAEBA710452.title: "Alternator"
	quest.84B0E8F0A2AF6216.quest_desc: [
		"Nether portals won't light. Try one: the fire goes out, and a block of the frame turns into an &5Obsidian Keyhole&r."
		"Search &eruined portals&r: every one hides a &bFragmented Obsidian Key&r in its chest."
		"Research the fragment at the Research Table (Metallurgy). It shows you how to cast it whole again: the fragment on a casting table, with 4 ingots of molten gold poured over it."
		"Use the &dObsidian Key&r on the keyhole and the portal will light. Every new portal needs its own key."
	]
	quest.84B0E8F0A2AF6216.quest_subtitle: "Unlock a nether portal"
	quest.84B0E8F0A2AF6216.title: "The Nether Key"
	quest.85A8A025C5D4688B.quest_desc: [
		"Order from your whole network at one counter."
	]
	quest.85A8A025C5D4688B.title: "Stock Ticker"
	quest.86654732C380E293.quest_desc: [
		"Blaze power for the Exotic Age."
	]
	quest.86654732C380E293.title: "Blaze Rods"
	quest.89E3FED37B09A7DA.quest_desc: [
		"Your first iron ingot. Look closer at your tools."
	]
	quest.89E3FED37B09A7DA.quest_subtitle: "Opens: Gears & Metals"
	quest.89E3FED37B09A7DA.title: "Iron"
	quest.8B0E0F4508CB98E6.quest_desc: [
		"Find a steady food source before you go far."
	]
	quest.8B0E0F4508CB98E6.title: "Something to Eat"
	quest.8B5A6B7980D1D2B8.quest_desc: [
		"Rotation into thrust."
	]
	quest.8B5A6B7980D1D2B8.title: "Propellers"
	quest.8B960D393A5F7F6C.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.8B960D393A5F7F6C.title: "Tyrian Steel"
	quest.8DE13429C2DED363.quest_desc: [
		"Store power for later."
	]
	quest.8DE13429C2DED363.title: "Accumulator"
	quest.8F574400B7F12669.quest_desc: [
		"Lapis is the key to research."
		""
		"Every recipe beyond vanilla has to be researched at the &eResearch Bench&r. Research costs &eXP&r plus a few sample items, and it's per player. One person can learn machines and supply the rest of the team."
		""
		"When you research an age, its chapter in this book opens."
	]
	quest.8F574400B7F12669.quest_subtitle: "Opens: March of Industry"
	quest.8F574400B7F12669.title: "The Price of Knowledge"
	quest.907F06D7468A6531.quest_desc: [
		"Lost cargo, still floating."
	]
	quest.907F06D7468A6531.title: "Drifting Cargo"
	quest.909F688C9015F0C6.quest_desc: [
		"Polished rose quartz in an iron sheet."
	]
	quest.909F688C9015F0C6.title: "Electron Tubes"
	quest.94BBFA5581DD8AEB.quest_desc: [
		"Machines that break blocks for you."
	]
	quest.94BBFA5581DD8AEB.title: "Drills and Saws"
	quest.9974DE548ABA45E5.quest_desc: [
		"A multiblock that melts metal: a &eFoundry Controller&r in a brick wall, an air inside up to 7x7 and 8 tall over a floor made entirely of &eSolid Fuel Heaters&r, a brick ring around the heaters, walls of bricks and &eFoundry Drains&r, and a &eBrick Wall&r up every corner. Put items in through the controller. Hold &eW&r over the controller for a Ponder."
		"Raw and crushed ore melt into &emore&r than an ingot: x1.2 in brick."
		""
		"Blow a running Create fan into an &eAir Intake&r in the ring around the heaters for more heat, slower heat loss, x1.4 ore and &ealloying&r (brass, netherite and Silent Gear's alloys only come from here)."
		"Later, &eFire Bricks&r and &eLava Heaters&r: hotter, x1.6, slower heat loss, and the diamond-tier metals. Melt sand into &eMolten Glass&r here, then pour 250 mB over &eFire Clay&r on a casting table for a &eFire Brick&r; four make a block."
	]
	quest.9974DE548ABA45E5.title: "The Foundry"
	quest.99B23FA3B8E06D0D.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r copper fluid handling, brass, and the foundry."
		""
		"&7Until then these recipes stay hidden in JEI and can't be crafted. You can still use and trade the items if someone else makes them."
	]
	quest.99B23FA3B8E06D0D.quest_subtitle: "Learn this age at the Research Bench"
	quest.99B23FA3B8E06D0D.title: "Alloy Age"
	quest.9D2A3276DE5365BC.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.9D2A3276DE5365BC.title: "Gold"
	quest.9DDE83C75F74BA65.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r brass machines, mechanical crafters, deployers and arms, precision mechanisms, crushing wheels, steam engines and trains."
		""
		"&7Until then these recipes stay hidden in JEI and can't be crafted. You can still use and trade the items if someone else makes them."
	]
	quest.9DDE83C75F74BA65.quest_subtitle: "Learn this age at the Research Bench"
	quest.9DDE83C75F74BA65.title: "Brass Age"
	quest.9E17EC2B80200F11.quest_desc: [
		"Grind ores, flowers and gravel."
	]
	quest.9E17EC2B80200F11.title: "Millstone"
	quest.9F6F46C2189FAF8B.quest_desc: [
		"A block that wants to float."
	]
	quest.9F6F46C2189FAF8B.title: "Levitite"
	quest.9F8FEF58EF2D6A89.quest_desc: [
		"The next age needs blaze power. The Nether opens through a server-wide project."
		"See &eInto the Unknown: The Nether&r."
	]
	quest.9F8FEF58EF2D6A89.title: "The Nether Is Calling"
	quest.A0C4D919AA3197C5.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.A0C4D919AA3197C5.title: "Copper"
	quest.A1B72F262A31BCFA.quest_desc: [
		"A Sigil of Socketing adds &bone extra socket&r to any piece of gear, at the smithing table. Each item can take only one."
		""
		"Sigils can't be crafted. They come from quests, raid Elites and Invaders, and from beating every wave of a night raid."
	]
	quest.A1B72F262A31BCFA.title: "Sigil of Socketing"
	quest.A51226797E7CF426.quest_desc: [
		"A burner under an envelope. The simplest way up."
	]
	quest.A51226797E7CF426.title: "Hot Air"
	quest.A7103F6D54C8870C.quest_desc: [
		"Presses ingots into sheets."
	]
	quest.A7103F6D54C8870C.title: "Mechanical Press"
	quest.AC09C81595E8C819.quest_desc: [
		"Reaching the End is the milestone for &5Pinnacle&r (with 60 hours of play)."
	]
	quest.AC09C81595E8C819.quest_subtitle: "Reach the End"
	quest.AC09C81595E8C819.title: "Pinnacle"
	quest.ACB3E347E1F626CF.quest_desc: [
		"Box up items and send them by frog."
	]
	quest.ACB3E347E1F626CF.title: "Packages"
	quest.AD88A160457BA96D.quest_desc: [
		"Automated ore processing. The foundry was the first upgrade. This is the next."
	]
	quest.AD88A160457BA96D.title: "Crushing Wheels"
	quest.B00685259C307645.quest_desc: [
		"Fill and empty items with liquids."
	]
	quest.B00685259C307645.title: "Spout and Drain"
	quest.B6872F8D80B7F51F.quest_desc: [
		"Power back into rotation, wherever you need it."
	]
	quest.B6872F8D80B7F51F.title: "Electric Motor"
	quest.B7743506000A68FD.quest_desc: [
		"There's no enchanted 'affix' loot here: Apotheosis gives &dgems&r only."
		""
		"Monsters drop them now and then. Raid &6Elites&r always drop one, and &5Invaders&r several."
		""
		"Put a gem in a socket at the smithing table (gear in the middle, gem on the right). A &bSigil of Withdrawal&r takes gems back out."
	]
	quest.B7743506000A68FD.title: "Your First Gem"
	quest.BAF4C2C8B1FCA99A.quest_desc: [
		"This chapter guides you through the age once you've researched it."
		""
		"&eResearch unlocks:&r the Melee Elemental research focus (Fire Aspect, and Smite's lightning) when you bind books at an enchanting table. Exotic material chains come in a later update."
		""
		"&7Enchanting itself is open from the start: the quests below walk through it."
	]
	quest.BAF4C2C8B1FCA99A.quest_subtitle: "Learn this age at the Research Bench"
	quest.BAF4C2C8B1FCA99A.title: "Exotic Age"
	quest.BD28D265D7D81A23.quest_desc: [
		"&6Silent Gear&r tools, weapons and armour gain &eXP&r as you use them: tools by mining (ores give more), weapons by hitting monsters, armour by taking hits from mobs."
		""
		"Every level gives &a+5% to all stats&r. Levels &b3, 6 and 9&r each add a &bgem socket&r."
		""
		"The top level depends on your world tier: 3 in Haven, 5 Frontier, 7 Ascent, 9 Summit, 10 Pinnacle. XP keeps counting at the cap."
		""
		"The Salvager won't take apart gear with levels or gems."
	]
	quest.BD28D265D7D81A23.title: "Gear That Grows"
	quest.C498BC94A5589DF8.quest_desc: [
		"Moor your ship at a dock."
	]
	quest.C498BC94A5589DF8.title: "Docking"
	quest.CCD45BF31A4763F2.quest_desc: [
		"Every machine costs stress units (SU). Goggles show how much your network can handle."
	]
	quest.CCD45BF31A4763F2.title: "Stress"
	quest.CDDC586BD5311E42.quest_desc: [
		"A grey stone with a future. Andesite plus iron makes andesite alloy, the backbone of Create. You'll need to research it first."
	]
	quest.CDDC586BD5311E42.quest_subtitle: "The start of every machine"
	quest.CDDC586BD5311E42.title: "Andesite"
	quest.CF7EF539889F3C85.quest_desc: [
		"Every &c5th night&r raiders come for the Overworld: a &cNight Raid&r. You get a warning at dusk the evening before, and on the night &cbeds don't work&r."
		""
		"From nightfall, waves of raiders spawn &e30-40 blocks&r from every player who is on the ground. They come for you, and if they can't reach you they &cbreak in&r: about 30 seconds per block."
		""
		"They can only break plain Minecraft blocks. &aChests, furnaces, beds and every block from Create, Create: New Age, the foundry or any other mod are safe&r, and so is obsidian."
		""
		"Players &bon an airship or flying&r get no waves. Players close together share one siege."
		""
		"&7/silentraids status&r shows when the next one is."
	]
	quest.CF7EF539889F3C85.quest_subtitle: "Read me"
	quest.CF7EF539889F3C85.title: "The Night Raid"
	quest.D11F451A37DE5F06.quest_desc: [
		"Villages float high above the build limit. Land, trade, and see what they sell."
	]
	quest.D11F451A37DE5F06.title: "Sky Village"
	quest.D1D85BFBAF44A09D.quest_desc: [
		"Your first sequenced assembly line: deploy, press, repeat."
	]
	quest.D1D85BFBAF44A09D.title: "Precision Mechanism"
	quest.D258FA6E0B350AD5.quest_desc: [
		"Turns a build into a moving physics object."
	]
	quest.D258FA6E0B350AD5.title: "Physics Assembler"
	quest.D46561196732649E.quest_desc: [
		"&c-&r No building or breaking at or above &bY 250&r."
		"&c-&r The Nether is &b1:1&r with the Overworld. It's a destination, not a shortcut."
		"&c-&r No elytra and no teleporting."
		"&c-&r Mob farms don't work. XP comes from exploring."
		"&c-&r XP is &eknowledge&r: you spend it to research new recipes."
	]
	quest.D46561196732649E.title: "Server Rules"
	quest.D6BFAAAE8DC45F87.quest_desc: [
		"The ground is yours to build on. The sky is not."
		""
		"Everything valuable floats above &bY 250&r, where nobody can place or break blocks. To reach it you'll need to build something that flies."
		""
		"Start like any vanilla world. This book is your guide: it opens new chapters as you find things and learn new ages."
	]
	quest.D6BFAAAE8DC45F87.quest_subtitle: "Read me first"
	quest.D6BFAAAE8DC45F87.title: "Welcome to Empyrean Engines"
	quest.D74E43DBFCECFBCF.quest_desc: [
		"Carry power between buildings."
	]
	quest.D74E43DBFCECFBCF.title: "Wiring"
	quest.DDBC83D1289E3DB3.quest_desc: [
		"Shelve the researched focus in a chiseled bookshelf two blocks from the table, with a clear block between."
		""
		"Now put a tool, weapon or armour piece in the table: the buttons list what the shelved foci know. Pick exactly the enchantments you want. Books are never used up."
	]
	quest.DDBC83D1289E3DB3.title: "Chosen Enchantment"
	quest.E17A9DE819FE4B0D.quest_desc: [
		"Picks up and places items between machines."
	]
	quest.E17A9DE819FE4B0D.title: "Mechanical Arm"
	quest.E3A677EAB095C8E7.quest_desc: [
		"More power, no river needed."
	]
	quest.E3A677EAB095C8E7.title: "Windmill"
	quest.E702A41C8850A300.quest_desc: [
		"Paint your gear any colour you like."
	]
	quest.E702A41C8850A300.title: "A Splash of Colour"
	quest.EBE2E9D7B112391A.quest_desc: [
		"Blueprints and templates shape the parts. Craft a blueprint for the part you want, then craft it with your material."
	]
	quest.EBE2E9D7B112391A.title: "Blueprints"
	quest.ECC25586EC50AADA.quest_desc: [
		"Every tool and piece of armour here is built from &eparts&r: a head, a rod, sometimes a binding or grip."
		"Each part's material decides the stats. Hover a tool and hold Shift to see them."
		""
		"Better materials come from exploring. You won't know which metal is best until you find it."
	]
	quest.ECC25586EC50AADA.title: "Look Closer at Your Pickaxe"
	quest.EEA9A940BEB15687.quest_desc: [
		"Take your ship above &bY 250&r and bring it back in one piece."
	]
	quest.EEA9A940BEB15687.title: "First Flight"
	quest.EF3A8F11B527ABAD.quest_desc: [
		"Blow through fire to smelt, through water to wash."
	]
	quest.EF3A8F11B527ABAD.title: "Encased Fan"
	quest.F0E6D2A6339B8D62.quest_desc: [
		"Each metal gets its own entry here once you hold it. Rumours so far:"
		"&7-&r Something red runs in the walls of the Nether."
		"&7-&r Blue veins are said to glitter in the End."
		"&7-&r Black crystals hide deep below the stone."
		"&7-&r Some of the best metals aren't mined at all. They're alloyed in the foundry."
		""
		"The &eFoundry&r (Alloy Age) casts parts and doubles your ore."
	]
	quest.F0E6D2A6339B8D62.quest_subtitle: "Hints for hidden entries"
	quest.F0E6D2A6339B8D62.title: "Field Notes: Metals"
	quest.F17E7E05A160CC66.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.F17E7E05A160CC66.title: "Crimson Steel"
	quest.F20B642B11B151E9.quest_desc: [
		"Move items between machines."
	]
	quest.F20B642B11B151E9.title: "Belts"
	quest.F23D3779B9A7EA81.quest_desc: [
		"Grind spare gems into &dgem dust&r at the Salvaging Table, then use the Gem Cutting Table to raise a gem's purity."
	]
	quest.F23D3779B9A7EA81.title: "Gem Cutting"
	quest.F52B627E99FFF93E.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.F52B627E99FFF93E.title: "Bort"
	quest.F90E583FB003DD52.quest_desc: [
		"A new material for your gear. Check its stats with Shift."
	]
	quest.F90E583FB003DD52.title: "Diamond"
	quest.FA5E2AA3C9E46332.quest_desc: [
		"A hand that uses items for you."
	]
	quest.FA5E2AA3C9E46332.title: "Deployers"
}
