	quest.CDDC586BD5311E42.quest_subtitle: "Opens: March of Industry"
	quest.CDDC586BD5311E42.title: "Andesite"
	quest.D11F451A37DE5F06.quest_desc: [
		"Villages float high above the build limit. Land, trade, and see what they sell."
	]
	quest.D11F451A37DE5F06.title: "Sky Village"
	quest.D1D85BFBAF44A09D.quest_desc: [
		"Your first sequenced assembly line: deploy, press, repeat."
	]
	quest.D1D85BFBAF44A09D.title: "Precision Mechanism"
	quest.D258FA6E0B350AD5.quest_desc: [
		"Turns a build into a moving physics object."
	]
	quest.D258FA6E0B350AD5.title: "Physics Assembler"
	quest.D46561196732649E.quest_desc: [
		"&c-&r No building or breaking at or above &bY 250&r."
		"&c-&r The Nether is &b1:1&r with the Overworld. It's a destination, not a shortcut."
		"&c-&r No elytra and no teleporting."
		"&c-&r Mob farms don't work. XP comes from exploring."
		"&c-&r XP is &eknowledge&r: you spend it to research new recipes."
	]
	quest.D46561196732649E.title: "Server Rules"
	quest.D6BFAAAE8DC45F87.quest_desc: [
		"The ground is yours to build on. The sky is not."
		""
		"Everything valuable floats above &bY 250&r, where nobody can place or break blocks. To reach it you'll need to build something that flies."
		""
		"Start like any vanilla world. The book opens new chapters as you find things."
	]
	quest.D6BFAAAE8DC45F87.quest_subtitle: "Read me first"
	quest.D6BFAAAE8DC45F87.title: "Welcome to Skybound"
	quest.D74E43DBFCECFBCF.quest_desc: [
		"Carry power between buildings."
	]
	quest.D74E43DBFCECFBCF.title: "Wiring"
	quest.E0236B653ECE5763.quest_desc: [
		"Pay the XP and hand in the samples to learn this tier's recipes."
		""
		"&eUnlocks:&r the IE coke oven, blast furnace and alloy kiln, copper fluid handling, brass, and the foundry."
		""
		"&7Research is per player. Each team member has to claim the reward to learn it."
	]
	quest.E0236B653ECE5763.quest_subtitle: "Research"
	quest.E0236B653ECE5763.title: "Research: Alloy Age"
